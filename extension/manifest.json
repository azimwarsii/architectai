{
  "manifest_version": 3,
  "name": "ArchitectAI",
  "description": "Capture context from Cursor, Lovable, Bolt and other AI coding tools to your ArchitectAI canvas",
  "version": "1.0.0",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png"
    },
    "default_title": "ArchitectAI"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cursor.sh/*",
        "https://*.cursor.sh/*",
        "https://cursor.so/*",
        "https://*.cursor.so/*",
        "https://lovable.dev/*",
        "https://*.lovable.dev/*",
        "https://lovable.app/*",
        "https://*.lovable.app/*",
        "https://bolt.new/*",
        "https://*.bolt.new/*",
        "https://bolt.diy/*",
        "https://*.bolt.diy/*",
        "https://v0.dev/*",
        "https://*.v0.dev/*",
        "https://replit.com/*",
        "https://*.replit.com/*",
        "https://repl.it/*",
        "https://*.repl.it/*"
      ],
      "js": ["dist/content.bundle.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.architectai.app/*",
    "http://localhost:3000/*"
  ],
  "oauth2": {
    "client_id": "YOUR_OAUTH_CLIENT_ID",
    "scopes": ["openid", "email", "profile"]
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
